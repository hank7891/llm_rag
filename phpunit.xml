<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <groups>
        <exclude>
            <!-- 連線真實 Qdrant 的整合測試，預設不執行；執行方式見 tests/Feature/Rag/QdrantIntegrationTest.php -->
            <group>qdrant</group>
            <group>fulltext</group>
        </exclude>
    </groups>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="LLM_CHAT_PROVIDER" value="fake"/>
        <env name="LLM_EMBEDDING_PROVIDER" value="fake"/>
        <env name="RAG_RERANK_PROVIDER" value="fake"/>
        <env name="RAG_RERANK_ENABLED" value="false"/>
        <!-- 檢索與重排的策略固定為預設值，測試不受開發環境 .env 的調整影響（Ch12：.env 開啟 prefix_metadata 時測試曾因此失敗） -->
        <env name="RAG_RERANK_CANDIDATES" value="20"/>
        <env name="RAG_RERANK_KEEP_EXACT" value="true"/>
        <env name="RAG_RERANK_PREFIX_METADATA" value="false"/>
        <env name="RAG_RERANK_TIMEOUT" value="3"/>
        <env name="RAG_RETRIEVAL_MODE" value="hybrid"/>
        <env name="RAG_KEYWORD_ONLY_POLICY" value="exact_only"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="DB_DATABASE" value="rag_poc_testing"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
