APP_NAME="RAG POC"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL：Docker（對外 port 33060）
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=33060
DB_DATABASE=rag_poc
DB_USERNAME=rag
DB_PASSWORD=
DB_ROOT_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Ollama（macOS 原生）---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_EMBED_MODEL=bge-m3
OLLAMA_NUM_CTX=8192

# --- Embedding（config/llm.php 的 embedding 區塊）---
# 提問與建索引必須用同一個 provider 與模型；更換模型等於全部重建索引
LLM_EMBEDDING_PROVIDER=ollama
# 每次送給 /api/embed 的段數，影響速度與記憶體
OLLAMA_EMBED_BATCH_SIZE=16

# --- Qdrant（Docker）---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=company_docs_bge_m3

# --- 雲端 LLM（Ch02 才會用到）---
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- LLM 抽象層（config/llm.php）---
LLM_CHAT_PROVIDER=ollama

# --- Ollama（在既有 OLLAMA_* 下方加上）---
OLLAMA_THINK=false
OLLAMA_TIMEOUT=120

# --- AI 設定---
OPENAI_MODEL=gpt-4.1-mini
OPENAI_MAX_TOKENS=1024
OPENAI_TIMEOUT=60

GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MAX_TOKENS=1024
GEMINI_TIMEOUT=60

# --- 文件解析：poppler 的 pdftotext 執行檔（brew install poppler）---
# 填完整路徑：Queue Worker 等背景程式不一定有 /opt/homebrew/bin 的 PATH
# 移進 Docker（Linux）後改為 /usr/bin/pdftotex
PDFTOTEXT_PATH=/opt/homebrew/bin/pdftotext